EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
POSTGRES_URL=postgresql://tradbot:tradbot@localhost:5432/tradbot
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
MONITOR_PORT=8080
NOTIFY_LIFECYCLE=true        # false = pas de message Telegram au démarrage/arrêt

# Optimisation des swaps
CRYPTOUPDATE_DB=../CryptoUpdate/data/db.sqlite3
SWAP_MIN_GAIN_PCT=2          # alerte quand le swap retour rend >= 2 % d'unités en plus
SWAP_FEE_PCT=0.5             # frais estimés du swap retour
SWAP_CHECK_INTERVAL_MIN=15
SWAPS_API_TOKEN=             # secret Bearer pour POST /swaps (ex: openssl rand -hex 32) ; vide = désactivé
